<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
		 xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
		 bootstrap="vendor/autoload.php"
		 colors="true"
		 failOnWarning="true"
		 failOnRisky="true"
		 beStrictAboutOutputDuringTests="true">
	<testsuites>
		<!-- Only the WordPress-free core is covered here. The adapters under
			 src/WordPress are integration surface: they are exercised by the
			 host plugin's own suite, where WordPress exists. -->
		<testsuite name="unit">
			<directory>tests</directory>
			<exclude>tests/Double</exclude>
		</testsuite>
	</testsuites>
	<coverage>
		<include>
			<directory suffix=".php">src</directory>
		</include>
		<exclude>
			<directory suffix=".php">src/WordPress</directory>
		</exclude>
	</coverage>
</phpunit>
